      <Button fx:id="idDiv" layoutX="187.0" layoutY="171.0" mnemonicParsing="false" onAction="#btnDiv" prefHeight="39.0" prefWidth="102.0" text="/" />
      <TextField fx:id="idResultado" alignment="CENTER" layoutX="96.0" layoutY="250.0" prefHeight="39.0" prefWidth="150.0" text="RESULTADO" />
