<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="340.0" prefWidth="307.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="minicalculadora2.FXML_MiniCalculadora2Controller">
    <stylesheets>
        <URL value="@fxml_minicalculadora2.css" />
    </stylesheets>
   <children>
      <TextField fx:id="v1" alignment="CENTER" layoutX="42.0" layoutY="30.0" prefHeight="33.0" prefWidth="100.0" promptText="A" />
      <TextField fx:id="v2" alignment="CENTER" layoutX="165.0" layoutY="30.0" prefHeight="33.0" prefWidth="100.0" promptText="B" />
      <RadioButton fx:id="suma" layoutX="35.0" layoutY="108.0" mnemonicParsing="false" text="Suma" />
      <RadioButton fx:id="elevado" layoutX="208.0" layoutY="108.0" mnemonicParsing="false" text="Elevado" />
      <RadioButton fx:id="producto" layoutX="115.0" layoutY="108.0" mnemonicParsing="false" text="Producto" />
      <Button layoutX="50.0" layoutY="174.0" mnemonicParsing="false" onAction="#btnCalcular" prefHeight="34.0" prefWidth="207.0" text="Calcular">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="idResultado" layoutX="50.0" layoutY="225.0" mnemonicParsing="false" prefHeight="34.0" prefWidth="207.0" text="Resultado">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button layoutX="50.0" layoutY="278.0" mnemonicParsing="false" onAction="#btnReset" prefHeight="34.0" prefWidth="207.0" text="Reset">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
